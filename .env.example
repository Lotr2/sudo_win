# Copy to .env to override defaults. Placeholders only; nothing here is a secret.
# No paid service is needed: both models run locally through Ollama.

# Ollama server. Leave unset to use the Ollama container started by docker compose
# (or http://localhost:11434 when running without Docker).
# To use an Ollama already running on this machine from Docker, uncomment both lines:
# OLLAMA_HOST=http://host.docker.internal:11434
# SKIP_MODEL_PULL=1
OLLAMA_IMAGE=ollama/ollama:latest
# Keep both models loaded when memory allows (about 22 GB)
OLLAMA_MAX_LOADED_MODELS=2

# Models: research, building and judging / parsing, drafting and the Founder Liaison
MODEL_MAIN=gpt-oss:20b
MODEL_FAST=qwen3:14b
# 1 = run every role on MODEL_MAIN (for machines that can't hold both models)
QWEN_ROLES_ON_OSS=0

# Self-hosted search
SEARXNG_URL=http://localhost:8080
SEARXNG_IMAGE=searxng/searxng:latest
SEARXNG_SECRET=change-me

# full = every phase with the full conversation; demo = time budgets and a short conversation
RUN_MODE=full
