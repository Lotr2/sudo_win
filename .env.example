# Copy to .env to override defaults. Placeholders only; nothing here is a secret.
# No paid service is needed: the defaults use a local open-weight model through Ollama.

# Any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, llama.cpp server)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gpt-oss:20b
# Ollama ignores the key; only set a real one for a self-hosted server that requires it
LLM_API_KEY=ollama

# Docker image for the model server (pin a version here if you want fully repeatable runs)
OLLAMA_IMAGE=ollama/ollama:latest

# Where generated, git-ignored data goes (waitlist emails, built product, store database, support tickets)
RUNTIME_DIR=runtime

# Phase 1: maximum question rounds before asking whether to continue
DISCOVER_MAX_ROUNDS=8
# Phase 3: fix attempts per round before the founder is asked
BUILD_FIX_ATTEMPTS=5

# Servers (Phase 2 waitlist :8000, Phase 3 preview :8001, Phase 5 store :8002)
HOST=127.0.0.1
# Address buyers use to reach the store (used in delivery links)
PUBLIC_URL=http://localhost:8002
