# Copy to .env and fill in. Placeholders only; never commit .env.
# No paid service is needed: GPT-OSS-20B runs locally (Ollama or llama.cpp); Gemma 4 31B (optional) uses the free
# Gemini API tier. Gate thresholds, scoring weights and agentic-skill limits are in config/*.toml, not here.
# There are no payment settings: payments are MOCKED, with no provider, sandbox or keys.

# --- GPT-OSS-20B on Ollama: research, building and judging ---
# Docker uses the bundled Ollama. For an Ollama on another machine, set its address and start with
#   docker compose -f docker-compose.yml -f compose.remote-ollama.yaml up
# (Inside Docker the bundled Ollama is used and this value is ignored.)
OLLAMA_HOST=http://192.168.1.50:11434
MODEL_OSS=gpt-oss:20b
OLLAMA_IMAGE=ollama/ollama:latest
# Back end for GPT-OSS-20B: ollama (default) or llamacpp (llama.cpp's llama-server, started with --jinja).
# With Docker and llama.cpp on the host: docker compose -f docker-compose.yml -f compose.llamacpp.yaml up
OSS_BACKEND=ollama
LLAMACPP_URL=http://localhost:8090

# --- Gemma 4 31B on the Gemini API (free tier): parsing, drafting, copy, Founder Liaison ---
# Your own free key from Google AI Studio. Leave empty to run every role on MODEL_OSS.
GEMINI_API_KEY=
MODEL_GEMMA=gemma-4-31b-it
# 1 = run every role on MODEL_OSS even when a key is set (fully local)
GEMMA_ROLES_ON_OSS=0
# Free-tier limits the router keeps to (requests/min, tokens/min, requests/day)
GEMMA_RPM=30
GEMMA_TPM=15000
GEMMA_RPD=14400

# --- Search (self-hosted SearXNG, JSON format enabled in config/searxng/settings.yml) ---
# (Inside Docker the bundled SearXNG is used and this value is ignored.)
SEARXNG_URL=http://localhost:8080
# Engines to ask first (empty = the instance's defaults), and the ones retried when a search finds nothing.
# Public engines often block self-hosted search (CAPTCHA, rate limits); bing and yandex usually still answer.
SEARXNG_ENGINES=
SEARXNG_FALLBACK_ENGINES=bing,yandex
SEARXNG_IMAGE=searxng/searxng:latest
SEARXNG_SECRET=change-me

# --- Run ---
# full = every phase with the full conversation; demo = time budgets, 5 sources per variant, short conversation
RUN_MODE=full
# Where runs are stored (git-ignored)
RUNS_DIR=runs

# --- Timeouts in seconds ---
OLLAMA_TIMEOUT=600
GEMINI_TIMEOUT=180
SEARCH_TIMEOUT=20
FETCH_TIMEOUT=15
