# Copy to .env to override defaults. Placeholders only; nothing here is a secret.
# No paid service is needed: the defaults use a local open-weight model through Ollama.

# Any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, llama.cpp server)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
# Ollama ignores the key; only set a real one for a self-hosted server that requires it
LLM_API_KEY=ollama

# Docker image for the model server
OLLAMA_IMAGE=ollama/ollama:latest

# Where git-ignored working data of a run goes
RUNTIME_DIR=runtime
