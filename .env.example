# Copy to .env to override defaults. Placeholders only; nothing here is a secret.
# No paid service is needed: GPT-OSS-20B runs locally through Ollama; Gemma 4 31B uses the free Gemini API tier.

# Ollama server. Leave unset to use the Ollama container started by docker compose
# (or http://localhost:11434 when running without Docker).
# To use an Ollama already running on this machine from Docker, uncomment both lines:
# OLLAMA_HOST=http://host.docker.internal:11434
# SKIP_MODEL_PULL=1
OLLAMA_IMAGE=ollama/ollama:latest

# Models: research, building and judging /# Local model (Ollama): research, building and judging
MODEL_OSS=gpt-oss:20b

# Gemma 4 31B through Google's Gemini API (free tier): parsing, drafting, copy and the Founder Liaison.
# Put your own key in .env, never in this file. Leave it empty to run every role on MODEL_OSS.
GEMINI_API_KEY=
MODEL_GEMMA=gemma-4-31b-it
# 1 = run every role on MODEL_OSS even when a key is set (fully local)
GEMMA_ROLES_ON_OSS=0

calhost:8080
SEARXNG_IMAGE=searxng/searxng:latest
SEARXNG_SECRET=change-me

# full = every phase with the full conversation; demo = time budgets and a short conversation
RUN_MODE=full
