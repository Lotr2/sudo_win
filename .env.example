# Copy to .env (untracked) to override defaults. Placeholders only; no secrets are needed.

# Model server(s), OpenAI-compatible. Single-PC default: the local llama.cpp server.
# Two GPU PCs: LLM_ENDPOINTS=pc1=http://192.168.1.10:8080/v1,pc2=http://192.168.1.11:8080/v1
LLM_ENDPOINTS=local=http://localhost:8080/v1
LLM_SLOTS=4                 # parallel requests per server (= llama-server -np)
LLM_TIMEOUT_S=300

# llama.cpp server settings (docker-compose.yml, deploy/gpu-node)
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLM_HF_REPO=ggml-org/gpt-oss-20b-GGUF
LLM_MODEL=gpt-oss-20b       # served name; must match config/models.yaml
LLM_CTX=32768               # total context shared by all slots (32768 / 4 = 8192 per request)

ARCH_VARIANT=_template
